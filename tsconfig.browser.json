{
  "$schema": "https://json.schemastore.org/tsconfig",
  // The browser platform layer. Separate from the root project because it
  // needs the DOM lib, which the server must not have.
  //
  // It checks and does not emit. Vite builds the browser half now, from the
  // entry layer down, so this project's job is the claim no other project
  // makes: that the platform compiles with the DOM and nothing else, no node
  // types and no framework types, with third-party declarations checked. The
  // entry layer, which has React and Tamagui in scope, is tsconfig.app.json.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // No "node": browser code must not see process, Buffer, or fs.
    "types": [],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowJs": false,
    "checkJs": false
  },
  "include": ["src/platform-browser/**/*.mts"],
  // Worker code belongs to tsconfig.worker.json; it needs the WebWorker lib,
  // which cannot be loaded alongside DOM. It is excluded by living outside the
  // includes above rather than by being named here.
  "exclude": []
}
