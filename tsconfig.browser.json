{
  "$schema": "https://json.schemastore.org/tsconfig",
  // The browser half. Separate from the root project because it needs the
  // DOM lib, which the server must not have, and because it emits: no
  // browser strips types the way Node 24 does.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // No "node": browser code must not see process, Buffer, or fs.
    "types": [],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "outDir": "public/js",
    "rootDir": "src/browser",
    "sourceMap": true,
    "declaration": false,
    "allowJs": false,
    "checkJs": false,
    // Emit is on, so imports must be rewritten to the .js the browser will
    // actually fetch.
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/browser/**/*.mts"],
  // Worker code belongs to tsconfig.worker.json; it needs the WebWorker lib,
  // which cannot be loaded alongside DOM.
  "exclude": ["src/browser/gif-worker.mts"]
}
