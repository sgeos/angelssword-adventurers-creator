{
  "name": "as-adventurer",
  "version": "1.0.0",
  "description": "VTuber creation pipeline. TypeScript fork of the tool by Angel's Sword Studios.",
  "main": "server.mts",
  "engines": {
    "node": "^22.18.0 || >=23.6.0"
  },
  "scripts": {
    "start": "node server.mts",
    "typecheck": "tsc -p tsconfig.core.json && tsc --noEmit && tsc -p tsconfig.browser.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "test:unit": "node --test test/unit/*.test.mts",
    "test:api": "node --test test/integration/api/*.test.mts",
    "test:browser": "npm run build:browser && playwright test",
    "test": "npm run test:unit && npm run test:api",
    "test:all": "npm run check && npm run test && npm run test:browser",
    "build:exe": "node build-exe.mts",
    "build:browser": "tsc -p tsconfig.browser.json && tsc -p tsconfig.worker.json",
    "prestart": "npm run build:browser"
  },
  "dependencies": {
    "express": "^5.3.0",
    "form-data": "^4.0.0",
    "node-fetch": "^2.7.0"
  },
  "author": "Angel's Sword Studios",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/jsdom": "30.0.0",
    "@types/node": "^24.19.2",
    "@types/node-fetch": "^2.6.13",
    "@types/supertest": "7.2.1",
    "esbuild": "0.28.2",
    "eslint": "^10.13.0",
    "jsdom": "30.1.3",
    "postject": "1.0.0-alpha.6",
    "sharp": "^0.35.5",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "contributors": [
    "Brendan Sechter <sgeos@hotmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sgeos/angelssword-adventurers-creator.git"
  },
  "bugs": {
    "url": "https://github.com/sgeos/angelssword-adventurers-creator/issues"
  },
  "homepage": "https://github.com/sgeos/angelssword-adventurers-creator#readme"
}
