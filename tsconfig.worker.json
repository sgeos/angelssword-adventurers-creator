{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Web Worker code. Split from the browser project because the WebWorker and
  // DOM libs both declare `self` and cannot be loaded together; a worker that
  // shared the browser project would see `self` as a Window and would need a
  // type assertion to talk to its own scope. Keeping it separate lets the
  // worker stay assertion-free under the same strict rules as everything else.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "WebWorker"],
    // No "node" and no DOM: a worker sees neither.
    "types": [],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "outDir": "public/js",
    "rootDir": "src",
    "sourceMap": true,
    "declaration": true,
    "allowJs": false,
    "checkJs": false,
    "rewriteRelativeImportExtensions": true
  },
  // The two workers are platform adapters and live with the browser half. The
  // encoder they drive is core, and tsconfig.core.json is now what proves it
  // stays free of the DOM; this project continues to prove it survives the
  // WebWorker lib, which is a different claim.
  "include": [
    "src/platform-worker/**/*.mts",
    "src/core/gif-worker-core.mts",
    "src/core/gif-codec.mts"
  ],
  "exclude": []
}
