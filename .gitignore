node_modules/
dist/
backup/
*.log
*.lnk
test-results/
playwright-report/
blob-report/

# Project-local scratch directory, committed via a .gitkeep marker with
# its contents ignored. Use `tmp/` for transient files such as commit
# messages, draft text, scratch scripts, and probe outputs.
tmp/*
!tmp/.gitkeep

# Local, never-committed material such as credentials, API keys, and
# environment-specific secrets. Nothing here is tracked, not even a marker,
# so the directory is absent from a fresh clone until someone creates it.
secret/

# From sgeos/project-template. Environment files usually hold credentials, such as
# the provider keys the server reads, so commit an example with placeholder values
# instead.
.env
.env.*
!.env.example

# Agent runtime state, such as session lock files and host-specific settings. Local to
# each contributor's session and not project content.
.claude/
.codex/

# Operating system and editor droppings.
.DS_Store
Thumbs.db
*.swp
*~
nvim.log
