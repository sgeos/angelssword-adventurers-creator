{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Tests are the one place that legitimately sees both halves: they run
  // on Node, and they exercise browser modules directly rather than
  // through a compiled artefact. So this project alone carries the node
  // types and the DOM lib together.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "noEmit": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["test/**/*.mts", "test/**/*.mjs", "src/browser/**/*.mts"],
  // gif-worker.mts needs the WebWorker lib, which cannot be loaded beside DOM.
  // Only its message plumbing lives there; gif-worker-core.mts holds the
  // encoding and stays in this project so tests can reach it.
  "exclude": ["test/integration/browser", "src/browser/gif-worker.mts", "src/browser/timer-worker.mts"]
}
