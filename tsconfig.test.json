{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Tests are the one place that legitimately sees both halves: they run
  // on Node, and they exercise browser modules directly rather than
  // through a compiled artefact. So this project alone carries the node
  // types and the DOM lib together.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // isolatedDeclarations is inherited and stays on. It was off here while
    // the tests imported .js helpers and fixtures, because that needs allowJs
    // and the two are mutually exclusive; the last of those was converted, so
    // the exemption went with it. This project is now as strict as the rest.
    //
    // isolatedDeclarations requires that declarations *could* be emitted, so
    // declaration stays on; noEmit below means none actually are.
    "declaration": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "noEmit": true
  },
  "include": ["test/**/*.mts", "test/**/*.ts", "src/browser/**/*.mts", "playwright.config.ts"],
  // gif-worker.mts needs the WebWorker lib, which cannot be loaded beside DOM.
  // Only its message plumbing lives there; gif-worker-core.mts holds the
  // encoding and stays in this project so tests can reach it.
  "exclude": ["src/browser/gif-worker.mts", "src/browser/timer-worker.mts"]
}
