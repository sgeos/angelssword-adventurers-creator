{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Tests are the one place that legitimately sees both halves: they run
  // on Node, and they exercise browser modules directly rather than
  // through a compiled artefact. So this project alone carries the node
  // types and the DOM lib together.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The only project where isolatedDeclarations is off. Tests import .js
    // helpers and fixtures, which needs allowJs, and the two options are
    // mutually exclusive. Nothing imports a test, so the guarantee
    // isolatedDeclarations gives — that an exported type never has to be
    // inferred across a file boundary — buys nothing here.
    "isolatedDeclarations": false,
    "declaration": false,
    "declarationDir": null,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "noEmit": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["test/**/*.mts", "test/**/*.ts", "src/browser/**/*.mts", "playwright.config.ts"],
  // gif-worker.mts needs the WebWorker lib, which cannot be loaded beside DOM.
  // Only its message plumbing lives there; gif-worker-core.mts holds the
  // encoding and stays in this project so tests can reach it.
  "exclude": ["src/browser/gif-worker.mts", "src/browser/timer-worker.mts"]
}
